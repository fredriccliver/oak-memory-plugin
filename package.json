{
  "name": "oak-memory-plugin",
  "version": "0.2.0",
  "description": "Claude Code and Codex plugin exposing @openaikits/memory as an MCP server for persistent, cross-project long-term memory.",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "postinstall": "npm run build",
    "setup": "node scripts/setup.mjs",
    "build": "npm run build:server && npm run build:hook && npm run build:codex",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --alias:@openaikits/memory=./node_modules/@openaikits/memory/src/index.ts --external:pg-native --banner:js=\"import{createRequire as __oakCreateRequire}from'node:module';const require=__oakCreateRequire(import.meta.url);\"",
    "build:hook": "esbuild src/hook.ts --bundle --platform=node --format=esm --outfile=dist/hook.mjs",
    "build:codex": "node scripts/build-codex-package.mjs",
    "dev": "npm run build && node dist/index.mjs",
    "test": "npm run typecheck && npm run test:env-fallback",
    "test:env-fallback": "node scripts/env-fallback-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@openaikits/memory": "https://codeload.github.com/fredriccliver/Memory/tar.gz/961829f092caacf0e1960734f7d3c5a6a1d72da9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.10.9",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
